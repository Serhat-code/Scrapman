# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# INSEE (optionnel - fallback auto data.gouv si absent)
INSEE_API_KEY=

# Audit PageSpeed Insights (optionnel - audit_site reste null si absente,
# le scraper continue normalement sans audit). Clé gratuite (quota quotidien) :
# https://console.cloud.google.com/apis/library/pagespeedonline.googleapis.com
GOOGLE_PAGESPEED_API_KEY=

# Config
SCRAPMAN_DEFAULT_USER_ID=uuid-de-test
VILLE_PROSPECTEUR=Saint-Étienne
CALENDLY_URL=calendly.com/atlamazstudio/30min

# Chiffrement SMTP — DOIT être strictement identique à SMTP_ENCRYPTION_KEY
# défini dans frontend/.env.local (généré par le frontend lors du chiffrement,
# déchiffré ici par le worker). Génération : openssl rand -hex 32
SMTP_ENCRYPTION_KEY=

# URL publique de l'application — construit l'URL du pixel de suivi
# d'ouverture. Doit correspondre à NEXT_PUBLIC_APP_URL du frontend.
APP_URL=https://scrapman-nine.vercel.app

# Budget temps d'un passage du worker d'envoi, en secondes. Doit rester
# nettement sous le `timeout-minutes` de .github/workflows/send-worker.yml :
# le worker s'arrête proprement avant, plutôt que d'être tué par le runner.
WORKER_MAX_RUNTIME_SECONDS=1500
