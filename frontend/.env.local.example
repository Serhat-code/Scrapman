# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<votre-projet>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<remplacer-par-votre-cle-anon-supabase>

# Clé service_role Supabase (Project Settings > API). SERVEUR UNIQUEMENT —
# ne jamais exposer côté client. Utilisée pour générer les liens de
# confirmation d'inscription / réinitialisation de mot de passe sans passer
# par l'envoi d'email intégré de Supabase (on envoie nous-mêmes via Resend).
SUPABASE_SERVICE_ROLE_KEY=<remplacer-par-votre-cle-service-role-supabase>

# Resend (email transactionnel plateforme : confirmation inscription, reset
# mdp, invitations — distinct du SMTP que chaque équipe configure pour SA
# prospection). Compte gratuit sur resend.com (100 emails/jour).
RESEND_API_KEY=<remplacer-par-votre-cle-resend>
# Adresse d'expéditeur. Le domaine doit être vérifié dans Resend > Domains,
# mais la BOÎTE n'a pas besoin d'exister : la vérification porte sur le DNS
# (SPF/DKIM), pas sur un compte mail. `noreply@` est donc parfaitement valide
# même sans messagerie sur ce domaine.
# Sans domaine vérifié, garder onboarding@resend.dev — mode test, qui n'envoie
# qu'à l'adresse du titulaire du compte Resend et rejette tout autre destinataire.
RESEND_FROM_EMAIL=Scrapman <onboarding@resend.dev>
# Où atterrissent les réponses des utilisateurs. Sans elle, une réponse à un
# email de confirmation ou d'invitation est perdue silencieusement.
RESEND_REPLY_TO=

# Stripe (facturation). Clé secrète en mode test depuis le dashboard Stripe ;
# clé de signature webhook générée lors de la création de l'endpoint
# (dashboard Stripe ou `stripe listen` en local).
STRIPE_SECRET_KEY=<remplacer-par-votre-cle-secrete-stripe>
STRIPE_WEBHOOK_SECRET=<remplacer-par-votre-secret-webhook-stripe>

# Config Scrapman
NEXT_PUBLIC_VILLE_PROSPECTEUR=Saint-Étienne
NEXT_PUBLIC_CALENDLY_URL=calendly.com/atlamazstudio/30min

# Chiffrement du mot de passe SMTP (AES-256-GCM, 32 octets en hexadécimal)
# Génération : openssl rand -hex 32
SMTP_ENCRYPTION_KEY=

# NOTE — il n'y a volontairement PAS de variable d'URL publique ici. Toutes les
# URLs générées par le frontend (confirmation d'inscription, reset, invitation,
# retour Stripe) sont dérivées de `new URL(request.url).origin` : elles suivent
# donc automatiquement le domaine servi, y compris sur les déploiements de
# préview.
#
# Le seul endroit qui a besoin de l'URL en dur est le worker d'envoi, qui tourne
# sur GitHub Actions et n'a aucune requête entrante d'où déduire un domaine.
# Elle s'y configure comme secret GitHub `APP_URL` (cf. scraper/.env.example),
# et sert à construire le pixel de suivi d'ouverture.

# Déclenchement des workflows GitHub Actions (scraping et worker d'envoi).
# Vercel étant serverless, il ne peut pas exécuter Python lui-même : les
# boutons « Lancer le scraping » et « Envoyer maintenant » passent par
# l'API GitHub. Sans ces deux variables, ils renvoient 502.
# Jeton : Personal Access Token avec la portée `workflow`.
GITHUB_ACTIONS_TOKEN=<remplacer-par-votre-token-github>
GITHUB_REPO=<votre-compte>/<votre-depot>
